# =============================================================================
# LessonLagoon Environment Configuration Template (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# Database (SQLite local file for dev; PostgreSQL 16 for production)
# -----------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
# DigitalOcean PostgreSQL example:
# DATABASE_URL="postgresql://lessonlagoon:yourpassword@db-host:5432/lessonlagoon?schema=public"

# -----------------------------------------------------------------------------
# Next.js App & Session Secret
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="generate-with-openssl-rand-hex-32"

# -----------------------------------------------------------------------------
# Admin Email Allowlist (comma-separated; granted ADMIN access in /admin)
# -----------------------------------------------------------------------------
ADMIN_EMAILS="mvncsa@gmail.com,owner@lessonlagoon.mv"

# -----------------------------------------------------------------------------
# Firebase Configuration (Firebase Auth with Google + Analytics)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="lesson-lagoon.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="lesson-lagoon"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="lesson-lagoon.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# -----------------------------------------------------------------------------
# Optional NextAuth Google Provider
# -----------------------------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
