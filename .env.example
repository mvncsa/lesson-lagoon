# =============================================================================
# LessonLagoon Environment Configuration Template (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# Database (SQLite for local dev & testing; PostgreSQL 16 for production)
# -----------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
# DigitalOcean PostgreSQL example:
# DATABASE_URL="postgresql://lessonlagoon:yourpassword@db-host:5432/lessonlagoon?schema=public"

# -----------------------------------------------------------------------------
# Auth.js / NextAuth v5 Configuration
# -----------------------------------------------------------------------------
AUTH_SECRET="generate-with-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-your-client-secret"

# Admin Email Allowlist (comma-separated, Section 5, P1-AUTH-07)
ADMIN_EMAILS="owner@lessonlagoon.mv"

# -----------------------------------------------------------------------------
# Firebase Web App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="lesson-lagoon.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="lesson-lagoon"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="lesson-lagoon.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

FIREBASE_PROJECT_ID="lesson-lagoon"
FIREBASE_STORAGE_BUCKET="lesson-lagoon.firebasestorage.app"
