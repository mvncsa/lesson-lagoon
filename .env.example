# Database URL (SQLite for local dev & testing; PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://lessonlagoon:password@db-host:5432/lessonlagoon?schema=public"

# NextAuth / Auth.js configuration
AUTH_SECRET="generate-with-npx-auth-secret-or-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-your-client-secret"

# Admin email allowlist
ADMIN_EMAILS="owner@lessonlagoon.mv"
